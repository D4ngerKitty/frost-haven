tation><value name="ADD0"><block type="mapgettile" id=";2M:6NSyT8Q!=R4G^SLH"><value name="col"><shadow type="math_number" id="P}n%^blqd3NQoU^]5Xzm"><field name="NUM">36</field></shadow></value><value name="row"><shadow type="math_number" id="X{J@7a97dtsXqi^7oNWE"><field name="NUM">3</field></shadow></value></block></value><value name="ADD1"><block type="mapgettile" id="^I34fnULVE92*CBMD3A@"><value name="col"><shadow type="math_number" id="AB6h^ZG{.=2^EKn8mheb"><field name="NUM">36</field></shadow></value><value name="row"><shadow type="math_number" id="cs.+N0_F7-5zSw@X)*kq"><field name="NUM">13</field></shadow></value></block></value></block></value></block></value><next><block type="controls_if" id="d#x6d[:U^r8b7xMmM,K!"><value name="IF0"><shadow type="logic_boolean" id="w,+T_~3:1}$*7{TyLrT+"><field name="BOOL">TRUE</field></shadow></value><statement name="DO0"><block type="function_call" id="zm2C^PX2cklCZ|7N=JL1"><mutation name="introtext" functionid="9k4L@9nnj=qibdIwFFFb"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="kN8g$`+wV@TlKfrtew`M"><field name="TEXT">Long ago, before our world was frozen over, a great hero purged the land of all evil.</field></shadow></value><next><block type="function_call" id="Ys}cv;ELxCHF{[kEZ-A8"><mutation name="introtext" functionid="9k4L@9nnj=qibdIwFFFb"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="}Z~=t|~S95bhUoX*F3!L"><field name="TEXT">He locked it away into the deepest parts of the earth, it was never to be seen again.</field></shadow></value><next><block type="function_call" id="1Fb-^KN=BV1YT3wQn3xb"><mutation name="introtext" functionid="9k4L@9nnj=qibdIwFFFb"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id=")D!YbA$b3Gy{TOD*}ZBc"><field name="TEXT">Over time the mines shut down, and the world froze over</field></shadow></value><next><block type="function_call" id="m.dChMJT2]`t@Kgypq?B"><mutation name="introtext" functionid="9k4L@9nnj=qibdIwFFFb"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="3:0Eywps8q!NT7FpWK.d"><field name="TEXT">For centuries we've been living in this frozen wasteland never imagining the evil would return</field></shadow></value><next><block type="function_call" id="ZPtJxv5Ir`6+nKa?B?Z*"><mutation name="introtext" functionid="9k4L@9nnj=qibdIwFFFb"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="9o3{t4;jA(pp?P}6z^]C"><field name="TEXT">But what is locked away and forgotten about can always be set free and remembered</field></shadow></value></block></next></block></next></block></next></block></next></block></statement><next><block type="TilemapPath_follow_path" id="cwWSuilXa);S;g4|RbS|"><mutation xmlns="http://www.w3.org/1999/xhtml" _expanded="1" _input_init="true"></mutation><value name="sprite"><block type="variables_get" id="emA$-bM5#9[OQbLW1~78"><field name="VAR" id="R!-_{,*?pR^4zqzSU6T)">cam</field></block></value><value name="path"><block type="variables_get" id="wXW@beyWH^m8FYPS.ZA)"><field name="VAR" id="u,C}=Q=I|v.9wEj.hVAY">path</field></block></value><value name="speed"><shadow type="math_number" id="Z_T7JNq_9vREvDE1;HQ%"><field name="NUM">50</field></shadow></value><next><block type="function_call" id="[]!oM9N6NlQp9-:Pqw91"><mutation name="MakeNPCText" functionid="8D7fzIaG!Gx4=t7:1Op4"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="bgZ~~SQ?E}nb3C{g/vck"><field name="TEXT">Hello young one</field></shadow></value><next><block type="function_call" id="]59NZH2H]_Wo:ver:UE:"><mutation name="MakeNPCText" functionid="8D7fzIaG!Gx4=t7:1Op4"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="iHm1e@._QiZBLG$M[rw/"><field name="TEXT">My time here is almost over</field></shadow></value><next><block type="function_call" id="`2}:*}~!Fd=Q_omARPI("><mutation name="MakeNPCText" functionid="8D7fzIaG!Gx4=t7:1Op4"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="{([1,3LYBc)`~2lhQhiU"><field name="TEXT">Before I go I want you to have this</field></shadow></value><next><block type="function_call" id="k]dy}Fr.~1+1SN/sPBaj"><mutation name="MakeNPCText" functionid="8D7fzIaG!Gx4=t7:1Op4"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="YX?1*Lt!CY1mm%#Nrc4~"><field name="TEXT">Sword acquired</field></shadow></value><next><block type="function_call" id=")fv)j2)R(dBXUctR=ikX"><mutation name="MakeNPCText" functionid="8D7fzIaG!Gx4=t7:1Op4"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="0}z9Pb@3OoD?$mg0C5;e"><field name="TEXT">Use the E Key to open your inventory</field></shadow></value><next><block type="function_call" id="}Q9Bx|zOsl(!%`t^|#3%"><mutation name="MakeNPCText" functionid="8D7fzIaG!Gx4=t7:1Op4"><arg name="text" id="#[3!D;d0d{bLGe~]5%aR" type="string"></arg></mutation><value name="#[3!D;d0d{bLGe~]5%aR"><shadow type="text" id="_5S[wd$2`Qkstr??UpD%"><field name="TEXT">then on your sword click Z to equip it</field></shadow></value><next><block type="variables_set" id="%IBp4@co(UCbz/amv`nj"><field name="VAR" id="L^kBch.Z3k|:Z^7BGT#(">can open menu</field><value name="VALUE"><shadow type="math_number" id="Z@L~a/C?D~j$n@[d{fl-"><field name="NUM">0</field></shadow><block type="logic_boolean" id="|l5|XV)a/.~W%19_`-*L"><field name="BOOL">TRUE</field></block></value><next><block type="device_while" id="F8,pHB*-B//?